rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users can only access their own profile
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    
    // Exercises are readable by all authenticated users
    // Only admins can write exercises
    match /exercises/{exerciseId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    
    // Sessions are accessible only to participants
    match /sessions/{sessionId} {
      // Read access: user must have their UID in participantUids array
      allow read: if request.auth != null && 
        request.auth.uid in resource.data.participantUids;
      
      // Create access: user must be the creator
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.createdBy;
      
      // Update access: user must have their UID in participantUids array
      allow update: if request.auth != null && 
        request.auth.uid in resource.data.participantUids;
      
      // Delete access: only creator can delete
      allow delete: if request.auth != null && 
        request.auth.uid == resource.data.createdBy;
    }
    
    // Progress data is private to each user
    match /progress/{progressId} {
      allow read, write: if request.auth != null && 
        request.auth.uid == resource.data.uid;
    }
  }
}

// Note: The Admin SDK bypasses these rules
// These rules only apply to client SDK access (mobile/web apps)
