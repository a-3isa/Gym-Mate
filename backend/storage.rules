rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow users to upload and manage their own avatar
    match /avatars/{userId}.{ext} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId && 
        request.resource.size < 5 * 1024 * 1024 && // Max 5MB
        request.resource.contentType.matches('image/.*'); // Must be an image
    }
    
    // Exercise videos (if needed in the future)
    match /exercises/{exerciseId}/videos/{videoName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    
    // Default: deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
