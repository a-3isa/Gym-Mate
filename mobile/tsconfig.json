{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-native",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": "./src",
    "paths": {
      "@firebase/auth": ["./node_modules/@firebase/auth/dist/index.rn.d.ts"],
      "@components": ["components"],
      "@components/*": ["components/*"],
      "@contexts": ["contexts"],
      "@contexts/*": ["contexts/*"],
      "@hooks": ["hooks"],
      "@hooks/*": ["hooks/*"],
      "@screens/*": ["screens/*"],
      "@services/*": ["services/*"],
      "@navigation/*": ["navigation/*"],
      "@types/*": ["types/*"],
      "@utils/*": ["utils/*"],
      "@assets/*": ["assets/*"],
      "@theme": ["theme"],
      "@theme/*": ["theme/*"]
    }
  },
  
  "include": ["src", "App.tsx", "src/types"]
}
